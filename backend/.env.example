# ──────────────────────────────────────────────
#  ContractSense — Backend Environment Variables
#  Copy this file to .env and fill in your keys.
#  You only need ONE key to run. More = more fallback resilience.
# ──────────────────────────────────────────────

# 1. Google Gemini (FREE) → aistudio.google.com → "Get API Key"
#    Free tier: 15 RPM, 1M tokens/day. No credit card required.
GEMINI_API_KEY=

# 2. Groq / Llama-3.3-70b (FREE, FAST) → console.groq.com
#    Free tier: 14,400 req/day. OpenAI-compatible.
GROQ_API_KEY=

# 3. xAI Grok (FREE tier) → console.x.ai
#    Free tier: 25 req/hour on grok-3-mini. Needs X account.
GROK_API_KEY=

# 4. OpenAI GPT-4o (PAID) → platform.openai.com
#    New accounts get $5 credit. Paid after that.
OPENAI_API_KEY=
